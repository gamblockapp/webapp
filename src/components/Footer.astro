---
import { APP_NAME, CONTACT_EMAIL, LEGAL_NAME } from '../config';
import { otherLocale, path, t, type Locale } from '../i18n';
import Mark from './Mark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const other = otherLocale(locale);

/**
 * Hardcoded rather than `new Date().getFullYear()`: the site is statically built,
 * so a runtime year would silently freeze at whatever year the last deploy
 * happened in anyway. An explicit constant is at least honest about needing a
 * bump.
 */
const YEAR = 2026;

/**
 * Three columns, from the new page design, replacing one centred row of six
 * links.
 *
 * The grouping is the point rather than the shape: a flat row put the privacy
 * policy and the crisis line beside each other at the same weight, and they are
 * not the same kind of thing. The first column is the product, the second is how
 * to reach a person, the third is the paperwork.
 *
 * The first column's targets are in-page anchors on the landing page, written as
 * a full path plus a hash so they work from `/terms` as well as from `/`.
 */
const home = path(locale, 'home');

const columns = [
  {
    heading: copy.footer.appHeading,
    items: [
      { label: copy.footer.howItWorks, href: `${home}#forecast` },
      { label: copy.footer.theMoney, href: `${home}#money` },
      { label: copy.footer.yourData, href: `${home}#privacy` },
    ],
  },
  {
    heading: copy.footer.helpHeading,
    items: [
      { label: copy.nav.help, href: path(locale, 'help') },
      { label: copy.nav.support, href: path(locale, 'support') },
      { label: copy.footer.contact, href: `mailto:${CONTACT_EMAIL}` },
    ],
  },
  {
    heading: copy.footer.legalHeading,
    items: [
      { label: copy.nav.privacy, href: path(locale, 'privacy') },
      { label: copy.nav.terms, href: path(locale, 'terms') },
      { label: t(other).localeName, href: path(other, 'home'), lang: other },
    ],
  },
];
---

<footer class="site-footer">
  <div class="page site-footer__inner">
    <div class="site-footer__brand">
      <a class="wordmark" href={path(locale, 'home')}>
        <Mark class="wordmark__mark" size={22} />
        <span>{APP_NAME}</span>
      </a>
      <p class="small faint">{copy.footer.tagline(APP_NAME)}</p>
      {/* Load-bearing, and the reason it sits above the copyright rather than
           below it: it is a statement about the product, not a legal footer. */}
      <p class="small faint">{copy.footer.notTreatment}</p>
      <p class="small faint">{copy.footer.copyright(YEAR, LEGAL_NAME)}</p>
    </div>

    <nav class="footer-nav" aria-label={copy.nav.footerNavLabel}>
      {
        columns.map((column) => (
          <div class="footer-nav__col">
            <p class="eyebrow">{column.heading}</p>
            <ul class="footer-nav__list">
              {column.items.map((item) => (
                <li>
                  <a href={item.href} lang={'lang' in item ? item.lang : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(72px, 9vw, 120px);
    padding-block: var(--space-3xl) var(--space-4xl);
  }

  /*
   * The hairline is on the inner element rather than on the footer, so it lines
   * up with the page gutter instead of running edge to edge. The whole of the
   * rest of the page stops at that gutter; a full-bleed rule under it reads as
   * the bottom of a browser chrome rather than the bottom of the document.
   */
  .site-footer__inner {
    display: grid;
    gap: var(--space-3xl);
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--c-border);
  }

  @media (min-width: 52rem) {
    .site-footer__inner {
      grid-template-columns: 1.4fr repeat(3, 1fr);
      gap: var(--space-4xl);
      align-items: start;
    }
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-md);
    max-width: 24rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.3;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: var(--space-xs);
  }

  .wordmark span {
    letter-spacing: 0.5em;
    margin-right: -0.5em;
  }

  .wordmark__mark {
    color: var(--c-accent);
    flex: none;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2xl);
  }

  @media (min-width: 52rem) {
    .footer-nav {
      display: contents;
    }
  }

  .footer-nav__list {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-md);
    font-size: var(--type-small);
  }

  .footer-nav__list a {
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--motion-fast) ease-out;
  }

  .footer-nav__list a:hover {
    color: var(--c-text);
  }
</style>
