---
import { APP_NAME } from '../../config';
import { EMERGENCY_NUMBERS, helplineRegionsFor } from '../../data/helplines';
import { t, type Locale } from '../../i18n';
import Base from '../../layouts/Base.astro';

/**
 * The public mirror of the app's crisis screen.
 *
 * Not an App Store requirement — it exists because the duty-of-care section of
 * the plan says jurisdiction-appropriate crisis resources must always be
 * reachable, and someone can land on this site without ever installing anything.
 *
 * Two things this page must keep doing:
 *
 * - **Emergency numbers first, readable in one glance.** Not below the fold, not
 *   after the explanation.
 * - **`tel:` links on every number, and the number written out in full.** A
 *   browser that won't dial still shows something someone can key in by hand.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const c = copy.help;
const meta = copy.meta.help(APP_NAME);
const regions = helplineRegionsFor(locale);
---

<Base locale={locale} route="help" title={meta.title} description={meta.description}>
  <div class="page help">
    {/* No eyebrow above the title on this page or on /support: the label and the
         title would be the same words. */}
    <header class="doc-head">
      <h1 class="display-sm doc-head__title">{c.title}</h1>
      <p class="lead doc-head__lead">{c.intro}</p>
      <p class="small muted doc-head__note">{c.languageNote}</p>
    </header>

    <section class="emergency" aria-labelledby="emergency-heading">
      <h2 class="emergency__title" id="emergency-heading">{c.emergencyTitle}</h2>
      <p class="body-lg emergency__body">{c.emergencyBody}</p>
      {/*
        One card per number, and the number itself is the link. These are set at
        display size on purpose: this block is read by someone who is not
        reading, and the target has to be findable without aiming.
      */}
      <ul class="emergency__list">
        {
          EMERGENCY_NUMBERS.map((n) => (
            <li class="emergency__item">
              <a
                class="emergency__number"
                href={`tel:${n.dial}`}
                aria-label={c.callLabel(n.display, n.what[locale], n.where[locale])}
              >
                {n.display}
              </a>
              <span class="small emergency__what">
                {n.what[locale]} · {n.where[locale]}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      regions.map((region) => (
        <section class="region reveal">
          <h2 class="region__title">{region.title[locale]}</h2>
          <ul class="services">
            {/*
              One row per organisation: what it is on the left, how to reach it on
              the right. The card grid this replaced put a three-line description
              and a phone number in the same box at the same weight, and the
              number is the only part of it anybody is looking for.
            */}
            {region.services.map((service) => (
              <li class="service">
                <div>
                  <h3 class="service__name">{service.name}</h3>
                  <p class="service__what muted">{service.what[locale]}</p>
                </div>
                <ul class="contacts">
                  {service.contacts.map((contact) =>
                    contact.kind === 'phone' ? (
                      <li class="contact">
                        <a
                          class="contact-link contact-link--phone"
                          href={`tel:${contact.dial}`}
                          aria-label={c.call(contact.display)}
                        >
                          {contact.display}
                        </a>
                        {contact.note && <span class="small faint">{contact.note[locale]}</span>}
                      </li>
                    ) : (
                      <li class="contact">
                        <a
                          class="contact-link"
                          href={contact.url}
                          rel="noopener noreferrer"
                          aria-label={c.open(contact.display)}
                        >
                          {contact.display}
                        </a>
                        {contact.note && <span class="small faint">{contact.note[locale]}</span>}
                      </li>
                    ),
                  )}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <footer class="panel help__notes">
      <p class="body-lg muted">{c.checked}</p>
      <p class="body-lg muted">{c.notTreatment}</p>
    </footer>
  </div>
</Base>

<style>
  .help {
    padding-bottom: var(--space-2xl);
  }

  /* Danger clay, used here for the one thing on this site that is genuinely
     urgent. Still muted — an alarm red would read as a warning about the reader
     rather than a route out. */
  .emergency {
    margin-top: var(--space-3xl);
    padding: clamp(var(--space-xl), 3vw, 40px);
    background: var(--c-danger-soft);
    border: 1px solid var(--c-danger);
    border-radius: var(--radius-2xl);
  }

  .emergency__title {
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--c-danger);
  }

  .emergency__body {
    margin-top: var(--space-md);
    max-width: 52rem;
    color: var(--c-text-muted);
  }

  .emergency__list {
    margin-top: var(--space-2xl);
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 45rem) {
    .emergency__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .emergency__item {
    background: var(--c-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .emergency__number {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-danger);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    /* 48px minimum tap target — this is the link most likely to be pressed in a
       hurry, on a phone, by someone not aiming carefully. */
    min-height: 48px;
    display: flex;
    align-items: center;
  }

  .emergency__number:hover {
    text-decoration: underline;
  }

  .emergency__what {
    margin-top: var(--space-xs);
    color: var(--c-text-subtle);
  }

  .region {
    margin-top: clamp(56px, 6vw, 88px);
  }

  .region__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 400;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--c-border);
    text-wrap: balance;
  }

  .service {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--c-border);
  }

  @media (min-width: 52rem) {
    .service {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-5xl);
    }
  }

  .service__name {
    font-size: 1.3125rem;
    line-height: 1.35;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .service__what {
    margin-top: var(--space-sm);
    text-wrap: pretty;
  }

  .contacts {
    display: grid;
    gap: var(--space-md);
  }

  /* Each contact in its own surface, so a number is an object to hit rather than
     a line of text among lines of text. */
  .contact {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-link {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--c-accent);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    align-self: flex-start;
    min-height: 32px;
    display: flex;
    align-items: center;
  }

  /* A helpline number is dialled under the same conditions as an emergency one,
     so it gets the same target and the page's largest link size. Website links
     keep the tighter 32px — a mistyped tap on a URL costs a back button, not a
     call that didn't happen. */
  .contact-link--phone {
    font-size: 1.75rem;
    color: var(--c-text);
    min-height: 48px;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .help__notes {
    margin-top: clamp(56px, 6vw, 88px);
    display: grid;
    gap: var(--space-md);
    max-width: 60rem;
  }
</style>
