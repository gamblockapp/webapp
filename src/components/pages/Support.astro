---
import { APP_NAME, CONTACT_EMAIL, PAID } from '../../config';
import { path, t, type Locale } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { pricingStrings } from '../../pricing';
import Prose from '../Prose.astro';

/**
 * The page App Store Connect's "Support URL" points at. It has to resolve and it
 * has to offer a real way to reach a human, so the address is the first thing on
 * it rather than the last.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const c = copy.support;
const meta = copy.meta.support(APP_NAME);
const faqs = c.faqs(APP_NAME, pricingStrings(locale), PAID);
---

<Base locale={locale} route="support" title={meta.title} description={meta.description}>
  <div class="page support">
    {/*
      Two columns from 60rem up: the pitch on the left, the address in a card that
      sticks alongside it on the right.

      The single centred `--measure` column this replaced was the right call for a
      legal document and the wrong one here — on a wide monitor it left the page
      about a fifth full, with the one thing anybody comes to this page for
      (the email address) below the fold of a mostly empty screen.
    */}
    <header class="doc-head">
      <h1 class="display-sm doc-head__title">{c.title}</h1>
      <p class="lead doc-head__lead">{c.intro(APP_NAME)}</p>
      <p class="doc-head__note">
        {c.crisisLead} <a class="support__crisis" href={path(locale, 'help')}>{c.crisisLink} →</a>
      </p>
    </header>

    {/*
      The address, and what to put in the message, as a pair of cards above the
      questions. This is the page App Store Connect's "Support URL" points at, so
      the way to reach a human is the first thing on it rather than the last.
    */}
    <div class="support__cards">
      <div class="card card--interactive">
        <p class="eyebrow">{c.emailLead}</p>
        <p class="contact__address">
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
        <p class="body-lg muted">{c.responseNote}</p>
      </div>

      <div class="card">
        <p class="eyebrow">{c.bugTitle}</p>
        <div class="support__blocks">
          <Prose blocks={c.bugBlocks} />
        </div>
      </div>
    </div>

    <section class="support__faq reveal">
      <h2 class="eyebrow">{c.faqTitle}</h2>
      {/* One question per row, question beside answer. Two columns of stacked
           question-and-answer left the eye no consistent place to land; a
           question always in the same column can be scanned. */}
      <dl class="faq">
        {
          faqs.map((faq) => (
            <div class="faq__item">
              <dt class="faq__q">{faq.q}</dt>
              <dd class="faq__a">
                <Prose blocks={faq.a} />
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>

<style>
  .support {
    padding-bottom: var(--space-2xl);
  }

  .support__crisis {
    color: var(--c-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .support__crisis:hover {
    text-decoration: underline;
  }

  .support__cards {
    margin-top: var(--space-3xl);
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .support__cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card {
    padding: clamp(var(--space-xl), 3vw, 40px);
  }

  .contact__address {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-lg);
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .contact__address a {
    text-decoration: none;
  }

  .contact__address a:hover {
    text-decoration: underline;
  }

  .support__blocks {
    margin-top: var(--space-lg);
    color: var(--c-text-muted);
    font-size: var(--type-body-lg);
    line-height: 1.67;
  }

  .support__faq {
    margin-top: clamp(56px, 6vw, 96px);
  }

  .faq {
    margin-top: var(--space-2xl);
  }

  .faq__item {
    display: grid;
    gap: var(--space-md);
    align-items: start;
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--c-border);
  }

  @media (min-width: 56rem) {
    .faq__item {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-5xl);
    }
  }

  .faq__q {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.1vw, 1.625rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .faq__a {
    color: var(--c-text-muted);
    font-size: var(--type-body-lg);
    line-height: 1.67;
    /* `Prose.astro` holds its paragraphs to `--measure`; in this column the
       answer is the wide half and 34rem left a ragged gutter beside it. */
    --measure: 44rem;
  }
</style>
