---
import { APP_NAME, CAMPAIGN, PRICING, appStoreLink, PAID } from '../../config';
import { path, t, type Locale } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { pricingStrings } from '../../pricing';

/**
 * The landing page.
 *
 * Composition notes, because they were decisions rather than defaults:
 *
 * - **The product is in the hero.** A forecast panel sits beside the headline
 *   instead of three screens down. Someone deciding whether to install this
 *   needs to see what it looks like before reading an argument about the house
 *   edge. It is the app's home screen rendered in the page's own materials
 *   rather than a phone bezel, because a picture of a phone on a phone is a
 *   picture of a phone.
 * - **Sections are separated by space and a hairline**, not by alternating
 *   tints. Four tinted bands in a row were what made the middle of the page read
 *   as one long thing; a shared rhythm — eyebrow, heading, then a two-column
 *   body — does the same job without the stripes.
 * - **The sonar trace is the one bit of decoration that argues.** The app is
 *   called Sonar and it draws bars: the cover breathes a field of them and the
 *   home screen's week strip is seven. Someone who meets the site and then opens
 *   the app should recognise the second from the first.
 * - **Motion is allowed here now, with one exception.** See AGENTS.md: the "no
 *   motion at all" rule was lifted for the website. The exception that survived
 *   it is the money figure — it is what somebody lost, and rolling it upward
 *   like a jackpot counter would make a joke of the one number on this page that
 *   is supposed to land. The design file this layout comes from does exactly
 *   that, with a 1.6s `requestAnimationFrame` count from £0. It is not carried
 *   over; the figure is styled large and left completely still.
 * - **Everything here is CSS.** The design file drives its reveals and its
 *   365-night grid from an `IntersectionObserver`. This site's privacy policy
 *   claims it loads and runs no JavaScript, so the reveals are
 *   `animation-timeline: view()` (see base.css) and the grid is simply drawn.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const c = copy.landing;
const meta = copy.meta.home(APP_NAME);
const pricing = pricingStrings(locale);

/**
 * The sonar trace under the hero copy, ported from `mobile/components/SonarWave.tsx`.
 *
 * Same arithmetic as the app, so the silhouette is the same object. Two sines
 * multiplied, one for the swell and one for the envelope, which gives the field
 * a shape rather than a sawtooth and stops any two neighbours matching.
 *
 * Computed here, at build time, because this site ships no client-side
 * JavaScript at all. Each bar carries its own height and delay as custom
 * properties and CSS does the rest.
 */
const TRACE_BARS = 48;
const TRACE_PERIOD_S = 9;
const trace = Array.from({ length: TRACE_BARS }, (_, i) => {
  const swell = 0.5 + 0.5 * Math.sin(i * 0.38 - 1.1);
  const envelope = 0.4 + 0.6 * (0.5 + 0.5 * Math.sin(i * 0.13 + 0.6));
  return {
    // The app's 8–52px bar inside a 56px field, kept as a fraction so the field
    // can be any height without redoing the numbers.
    height: (8 + 44 * swell * envelope) / 56,
    // Negative, so the field is already mid-cycle on first paint rather than
    // starting from a flat wall and brightening once while someone watches.
    delay: -(i / TRACE_BARS) * TRACE_PERIOD_S,
  };
});

/**
 * The headline's second tier, one sentence per line.
 *
 * `line1` is two short sentences — "Not over a year. Not over ten." — and the
 * design sets each on its own line, which is also what makes the pair read as a
 * timescale rather than as a wrapped paragraph. Split here for display only, the
 * same way `refusalList` is: the copy stays one string, so a rewrite doesn't have
 * to think about the markup and a locale that writes it as one sentence simply
 * gets one line.
 */
const headlineLines = c.line1.split(/(?<=\.)\s+/);

/** Ties each band label to its palette tone, in the app's own order. */
const BAND_TONES = ['low', 'elevated', 'high'] as const;
type BandTone = (typeof BAND_TONES)[number];

/** How tall each band's bar is drawn in the three-band chart, as a percentage. */
const BAND_HEIGHT: Record<BandTone, number> = { low: 22, elevated: 54, high: 86 };

/**
 * The week strip in the forecast panel — tonight first, then the six nights
 * after it. Elevated tonight, matching `mock.band`, with the weekend after
 * payday high: this is the shape the mock-up's reasons describe, so the chart
 * and the sentences beside it have to agree.
 */
const WEEK: BandTone[] = ['elevated', 'high', 'low', 'low', 'low', 'elevated', 'low'];

/**
 * The evidence marks beside each reason.
 *
 * Five bars per reason, of which the lit ones are what that reason read. They
 * are a sparkline of the same three signals the copy names — money landing, the
 * two slips on payday, the fixtures — and they are labelled as such by
 * `forecast.marks`, because an unlabelled chart beside a sentence is decoration
 * pretending to be evidence.
 */
const EVIDENCE: { heights: number[]; lit: number[]; tone: BandTone }[] = [
  { heights: [20, 20, 100, 68, 46], lit: [2, 3, 4], tone: 'elevated' },
  { heights: [100, 26, 100, 26, 26], lit: [0, 2], tone: 'high' },
  { heights: [100, 100, 100, 18, 18], lit: [0, 1, 2], tone: 'elevated' },
];

/**
 * One mark per night of a year.
 *
 * Weekends carry the full clay and weeknights a diluted one — not a claim about
 * anybody's pattern, just enough variation that the block reads as 365 separate
 * nights rather than as a texture. Drawn once, statically; the design file fades
 * them in one at a time behind an observer, which is script this site doesn't run.
 */
const YEAR_NIGHTS = Array.from({ length: 365 }, (_, i) => i % 7 === 5 || i % 7 === 6);

/**
 * The App Store link, carrying the campaign token for this locale so App Store
 * Connect can separate English from French traffic. Null until the app is on
 * sale, which renders the "coming soon" badge instead.
 */
const storeHref = appStoreLink(locale === 'fr' ? CAMPAIGN.webFr : CAMPAIGN.webEn);
---

<Base locale={locale} route="home" title={meta.title} description={meta.description}>
  {/* Hero. The headline says what gambling is; the lead, one tier down, says
       what the app does about it. */}
  <section class="hero page">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__tagline">{c.tagline}</p>

        {/*
          Both halves of the claim are inside the H1, and at the same size now.
          "Nobody's up" on its own is a bare assertion, and "not over a year, not
          over ten" is the part that makes it a statement about the house edge
          rather than about the reader. The heading a screen reader announces
          should be the whole argument, and the tier that carries the qualifier
          should not look like a caption on it.
        */}
        <h1 class="display hero__headline">
          {c.hook}
          {headlineLines.map((line) => (
            <>
              <br />
              {line}
            </>
          ))}
        </h1>

        <p class="lead hero__lead">{c.lead(APP_NAME)}</p>

        <ul class="chips" aria-label={c.tagline}>
          {c.refusalList.map((refusal) => <li class="chip">{refusal}</li>)}
        </ul>

        {/*
          The trace. Purely presentational, so it is hidden from assistive tech —
          but it is not filler: it is the app's own bar field, at the app's own
          arithmetic, and it is the only place on this page the name is explained.
        */}
        <div class="trace" aria-hidden="true">
          {trace.map((bar) => (
            <span style={`--h:${(bar.height * 100).toFixed(2)}%;--d:${bar.delay.toFixed(2)}s`} />
          ))}
        </div>

        <div class="hero__cta">
          {
            storeHref ? (
              <a class="button button--lg" href={storeHref}>
                {c.download}
              </a>
            ) : (
              <p class="badge">{c.comingSoon}</p>
            )
          }
          <p class="small faint hero__note">{PAID ? c.comingSoonNote : c.comingSoonNoteFree}</p>
        </div>

        {/* The page's argument in a line each, for the reader who will not
             scroll. The last one is a price claim — see `facts` in types.ts. */}
        <ul class="facts">
          {c.facts(PAID).map((fact) => <li>{fact}</li>)}
        </ul>
      </div>

      {/* Invariant 2: the band never appears without the reasons under it. */}
      <figure class="hero__mock">
        <div class="forecast">
          <p class="eyebrow forecast__eyebrow">{c.mock.eyebrow} · {c.mock.today}</p>
          <p class="forecast__band">{c.mock.band}</p>

          <ul class="week" aria-hidden="true">
            {
              WEEK.map((tone, i) => (
                <li class={`week__day week__day--${tone}`} data-today={i === 0 ? '' : undefined}>
                  <span class="week__plot">
                    <span class="week__bar" style={`--h:${BAND_HEIGHT[tone]}%`} />
                  </span>
                  <span class="week__label">{c.mock.weekdays[i]}</span>
                </li>
              ))
            }
          </ul>

          <ul class="reasons">
            {
              c.mock.reasons.map((reason, i) => (
                <li class="reasons__item">
                  <span class={`marks marks--${EVIDENCE[i].tone}`} aria-hidden="true">
                    {EVIDENCE[i].heights.map((h, j) => (
                      <span
                        class="marks__bar"
                        data-lit={EVIDENCE[i].lit.includes(j) ? '' : undefined}
                        style={`--h:${h}%`}
                      />
                    ))}
                  </span>
                  <span>{reason}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <figcaption class="small faint mock__caption">{c.mock.caption}</figcaption>
      </figure>
    </div>
  </section>

  {/*
    The forecast, explained. The prose on the left, the scale it produces on the
    right — still the band labels with their caption, never a score.
  */}
  <section class="page section reveal" id="forecast">
    <div class="section__head">
      <p class="eyebrow">{c.forecast.eyebrow}</p>
      <h2 class="display-sm section__title">{c.forecast.title}</h2>
    </div>

    <div class="split">
      <div>
        <p class="body-lg muted">{c.forecast.body}</p>
        <p class="body-lg muted split__second">{c.forecast.marks}</p>
      </div>

      <div class="scale">
        <p class="eyebrow">{c.forecast.bandsEyebrow}</p>
        <ul class="bands reveal-group">
          {
            c.forecast.bands.map((label, i) => (
              <li class={`bands__item bands__item--${BAND_TONES[i]}`}>
                <span class="bands__plot">
                  <span class="bands__bar" style={`--h:${BAND_HEIGHT[BAND_TONES[i]]}%`} />
                </span>
                <span class="bands__label">{label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/*
      Invariant 2, stated as a feature rather than a footnote — and it runs the
      full width under both columns because it is about the chart *and* the
      reasons in the hero, not about either one on its own.
    */}
    <p class="body-lg muted forecast__caption">{c.forecast.caption}</p>
  </section>

  {/*
    The slip flow. `precise` is the load-bearing sentence on this page — the one
    that must not be tightened into the stronger, false claim — so it is set as
    the section rather than as a footnote inside it.
  */}
  <section class="page section reveal">
    <div class="section__head">
      <p class="eyebrow">{c.slip.eyebrow}</p>
      <h2 class="display-sm section__title">{c.slip.title}</h2>
    </div>

    <div class="split split--wide">
      {/*
        No quote marks and no attribution: it is not a testimonial, it is the
        claim the product is careful about. The rule down its left edge is what
        marks it as the sentence to read if you only read one.
      */}
      <blockquote class="statement">
        <p class="quote">{c.slip.precise}</p>
      </blockquote>
      <p class="body-lg muted">{c.slip.body}</p>
    </div>
  </section>

  {/* Money. The figure leads and the explanation follows it, and the example
       stays labelled as an example, out loud. */}
  <section class="page section reveal" id="money">
    <div class="section__head">
      <p class="eyebrow">{c.money.eyebrow}</p>
      <h2 class="display-sm section__title">{c.money.title}</h2>
    </div>

    <div class="panel money">
      <div class="money__top">
        <div>
          <p class="eyebrow">{c.money.exampleEyebrow}</p>
          <p class="small muted money__basis">{c.money.basis}</p>
          {/* Motionless. See the note at the top of this file. */}
          <p class="money__figure">{c.money.figure}</p>
        </div>
        <p class="body-lg muted money__note">{c.money.gridNote}</p>
      </div>

      {/* One mark per night. Presentational — the sentence above it is what
           carries the meaning, so there is nothing here to announce. */}
      <div class="year" aria-hidden="true">
        {YEAR_NIGHTS.map((weekend) => <span data-weekend={weekend ? '' : undefined} />)}
      </div>
      <div class="year__ends">
        <span class="small faint">{c.money.gridStart}</span>
        <span class="small faint">{c.money.gridEnd}</span>
      </div>

      <dl class="figures">
        {
          c.money.figures.map((figure) => (
            <div class="figures__item">
              <dt class="figures__value">{figure.value}</dt>
              <dd class="eyebrow figures__label">{figure.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="split split--cards">
      <div class="card">
        <p class="quote">{c.money.caveat}</p>
      </div>
      <div class="card">
        <p class="eyebrow">{c.money.bodyEyebrow}</p>
        <p class="body-lg muted card__body">{c.money.body}</p>
      </div>
    </div>
  </section>

  <section class="page section reveal">
    <p class="eyebrow">{c.trio.eyebrow}</p>

    <ol class="trio reveal-group">
      {
        c.trio.items.map((item, i) => (
          <li class="trio__item">
            <p class="trio__num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="trio__title">{item.title}</h3>
            <p class="body-lg muted">{item.body}</p>
          </li>
        ))
      }
    </ol>

    {/* The free promise, in the accent tone, because it is the one commitment on
         the page rather than a description of a feature. */}
    <div class="promise">
      <p class="quote">{c.trio.free}</p>
    </div>

    {/*
      Pricing, immediately under the free-forever promise and inside the same
      band. The adjacency is the whole design: read on its own, a price list in
      a recovery app is a thing to be suspicious of; read directly under "the
      urge screen and the helplines stay free whatever else happens", it reads
      as what it is. Splitting the two across sections is the one change that
      would make this worse than not having it.

      Nothing here may acquire urgency: no countdown, no "only today", no
      launch discount. A time-limited offer aimed at people with
      impulse-control difficulty is indefensible, and the app's own paywall
      copy refuses the same register on purpose.
    */}
    {
      PAID && (
        <div class="pricing">
          <p class="eyebrow">{c.pricing.eyebrow}</p>
          <p class="pricing__trial">{c.pricing.trial(PRICING.trialDays)}</p>
          <ul class="pricing__plans">
            {c.pricing.plans(pricing).map((plan) => <li>{plan}</li>)}
          </ul>
          <p class="small faint">{c.pricing.note}</p>
        </div>
      )
    }
  </section>

  {/* Privacy, and the gap that comes with it. The gap is on the landing page
       on purpose: better read here than discovered after a phone upgrade. */}
  <section class="page section reveal" id="privacy">
    <div class="section__head">
      <p class="eyebrow">{c.privacy.eyebrow}</p>
      <h2 class="display-sm section__title">{c.privacy.title}</h2>
    </div>

    <div class="split">
      <div>
        <p class="lead privacy__body">{c.privacy.body}</p>
        <p class="body-lg muted split__second">{c.privacy.analytics}</p>
        <p class="privacy__link">
          <a href={path(locale, 'privacy')}>{c.privacy.readPolicy} →</a>
        </p>
      </div>

      <div class="card gap">
        <p class="eyebrow">{c.privacy.gapTitle}</p>
        <p class="quote gap__lead">{c.privacy.gap}</p>
      </div>
    </div>
  </section>

  {/* What it isn't. Load-bearing: the not-treatment and doesn't-block
       disclaimers both live here, as plain statements rather than small print. */}
  <section class="page section reveal">
    <div class="section__head">
      <p class="eyebrow">{c.close.eyebrow}</p>
      <h2 class="display-sm section__title">{c.close.title}</h2>
    </div>

    <ul class="close reveal-group">
      {c.close.items.map((item) => <li class="body-lg muted">{item}</li>)}
    </ul>
  </section>

  {/* Crisis resources, at the foot of the argument. Whatever else this page
       persuaded anyone of, this is the link that has to be findable. */}
  <section class="page section reveal">
    <div class="panel crisis">
      <div>
        <p class="quote crisis__lead">{c.close.helpLead}</p>
      </div>
      <a class="button button--lg" href={path(locale, 'help')}>{c.close.helpLink}</a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    padding-top: clamp(48px, 6vw, 104px);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-4xl);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .hero__grid {
      /* The panel is a fixed object rather than a fraction of the page: past
         about 460px the week strip's day labels start floating apart. */
      grid-template-columns: minmax(0, 1fr) 27rem;
      gap: var(--space-5xl);
    }
  }

  .hero__tagline {
    color: var(--c-accent);
  }

  .hero__headline {
    margin-top: var(--space-xl);
    text-wrap: balance;
  }

  .hero__lead {
    margin-top: var(--space-xl);
    max-width: 38rem;
  }

  /* The three refusals as chips — mirrors the app's own Chip component, and
     reads as three confident statements rather than one flat sentence. */
  .chips {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .chip {
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-pill);
    background: var(--c-surface);
    font-size: var(--type-small);
    font-weight: 600;
  }

  .hero__cta {
    margin-top: var(--space-2xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
  }

  .hero__note {
    max-width: 16rem;
    text-wrap: pretty;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 60px;
    padding: var(--space-lg) var(--space-2xl);
    border: 1px solid var(--c-accent);
    border-radius: 14px;
    color: var(--c-accent);
    font-weight: 600;
  }

  .facts {
    margin-top: var(--space-4xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--c-border);
    display: grid;
    gap: var(--space-xl);
    color: var(--c-text-muted);
    text-wrap: pretty;
  }

  @media (min-width: 45rem) {
    .facts {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
    }
  }

  /* ---------- The sonar trace ---------- */

  .trace {
    margin-top: var(--space-2xl);
    height: 56px;
    max-width: 38rem;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .trace > span {
    flex: 1;
    height: var(--h);
    border-radius: 3px;
    background: var(--c-accent);
    /*
     * Dim, bright, dim, and never fully on. The design file peaks at 0.85, which
     * is right for a band with nothing over it — this one sits beside a headline
     * and a lead paragraph, and at that exposure the eye keeps going to the
     * movement instead of the sentence.
     */
    opacity: 0.1;
    animation: trace-breathe 9s linear infinite;
    animation-delay: var(--d);
  }

  @keyframes trace-breathe {
    0% {
      opacity: 0.1;
    }
    46% {
      opacity: 0.62;
    }
    100% {
      opacity: 0.1;
    }
  }

  /*
   * Reduced motion keeps the field and stops it moving. Asking for less movement
   * is not asking to be shown a plainer product, and this is the only place on
   * the page the name is explained. Held flat at a legible value, where the
   * standing wave is still the shape it was — that shape is the content, and it
   * survives without the travel.
   */
  @media (prefers-reduced-motion: reduce) {
    .trace > span {
      animation: none;
      opacity: 0.3;
    }
  }

  /* ---------- The forecast panel ---------- */

  .hero__mock {
    margin: 0;
  }

  .forecast {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-2xl) var(--space-xl) var(--space-lg);
    box-shadow: var(--shadow-lg);
  }

  .forecast__eyebrow {
    color: var(--c-text-subtle);
  }

  .forecast__band {
    margin-top: var(--space-md);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--c-risk-elevated-fg);
  }

  /* ---------- The week strip ---------- */

  .week {
    margin-top: var(--space-2xl);
    display: flex;
    gap: var(--space-sm);
  }

  .week__day {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
    min-width: 0;
  }

  /* Same construction as the three-band chart below: a well, and a fill sitting
     on the floor of it under a bright edge. Seven of them is the app's own week
     strip, which is where this idea comes from. */
  .week__plot {
    width: 100%;
    height: 84px;
    border-radius: var(--radius-md);
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .week__bar {
    width: 100%;
    height: var(--h);
    background: var(--tone-plot);
    border-top: 3px solid var(--tone-fg);
  }

  .week__day--low {
    --tone-plot: var(--c-risk-low-plot);
    --tone-fg: var(--c-risk-low-fg);
  }

  .week__day--elevated {
    --tone-plot: var(--c-risk-elevated-plot);
    --tone-fg: var(--c-risk-elevated-fg);
  }

  .week__day--high {
    --tone-plot: var(--c-risk-high-plot);
    --tone-fg: var(--c-risk-high-fg);
  }

  .week__day[data-today] .week__plot {
    border-color: var(--c-border-strong);
  }

  .week__label {
    font-size: var(--type-small);
    color: var(--c-text-subtle);
  }

  .week__day[data-today] .week__label {
    color: var(--c-text);
    font-weight: 600;
  }

  /* ---------- Reasons, and the marks beside them ---------- */

  .reasons {
    margin-top: var(--space-xl);
    display: grid;
  }

  .reasons__item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--space-lg);
    align-items: center;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--c-border);
    text-wrap: pretty;
  }

  .marks {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 28px;
  }

  .marks__bar {
    flex: 1;
    height: var(--h);
    border-radius: 2px;
    /* Unlit bars are the hairline tone: present, but plainly not what was read. */
