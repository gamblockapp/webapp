---
/**
 * The app's mark: two bars, the second held back.
 *
 * Inline SVG rather than an `<img>` for two reasons that both matter here. It
 * inherits `currentColor`, so the mark follows the palette into dark mode
 * instead of needing a second file; and it costs no request, which keeps the
 * privacy policy's claim that this site loads nothing external trivially true.
 *
 * Geometry is the identity bundle's `SonarMark n=1` and is not adjustable:
 * a 160-unit box, 28x120 bars at x=40 and x=92, corner radius 14. **The second
 * bar is held back by opacity, not by height** — both bars are the same size,
 * and shortening one is the most common way this mark gets drawn wrong.
 *
 * Rules from the bundle that apply wherever this is used: never recolour the
 * second bar independently, never set the mark in a risk band (amber and clay
 * mean something specific in the app and an icon that borrows them is claiming
 * a state), never render below 16px, and leave one bar-width of clear space.
 */
interface Props {
  /** Rendered size in px. Never below 16 — see above. */
  size?: number;
  class?: string;
}

const { size = 22, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 160 160"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect x="40" y="20" width="28" height="120" rx="14" fill="currentColor" />
  <rect x="92" y="20" width="28" height="120" rx="14" fill="currentColor" opacity="0.45" />
</svg>
