---
import { APP_NAME } from '../config';
import { t } from '../i18n';
import Legal from '../layouts/Legal.astro';
import { legalContext } from '../legal-context';

const copy = t('en');
const meta = copy.meta.privacy(APP_NAME);
---

<Legal
  locale="en"
  route="privacy"
  doc={copy.legal.privacy(legalContext('en'))}
  title={meta.title}
  description={meta.description}
/>
