---
import '../styles/base.css';

import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import {
  APP_NAME,
  APP_STORE_APP_ID,
  APP_STORE_URL,
  CAMPAIGN,
  CONTACT_EMAIL,
  LEGAL_NAME,
  PRICING,
  SITE_URL,
  PAID,
} from '../config';
import { alternates, otherLocale, path, t, type Locale, type RouteKey } from '../i18n';

/**
 * The shell every page uses. Owns <head>, the header and the footer.
 *
 * `route` is not decoration: it drives the canonical URL, the `hreflang`
 * alternates and the language switcher's target, all read from the one routing
 * table. A page that passes the wrong key gets the wrong canonical, so the type
 * is narrow on purpose.
 */
interface Props {
  locale: Locale;
  route: RouteKey;
  title: string;
  description: string;
}

const { locale, route, title, description } = Astro.props;
const copy = t(locale);
const other = otherLocale(locale);

const canonical = new URL(path(locale, route), SITE_URL).href;

/**
 * Two images, because the two consumers want different shapes and one file was
 * being asked to be both.
 *
 * `og-cover.png` is 1200×630, the ratio every unfurler crops to — a square was
 * getting centre-cropped to a band across the middle of the icon. `og-icon.png`
 * stays square because that is what `apple-touch-icon` is.
 *
 * The cover is generated from `design/og-cover.html`, which carries the app name
 * in it. Renaming the app means re-rendering it; see the README.
 */
const ogImage = new URL('/og-cover.png', SITE_URL).href;

/**
 * Structured data, and an honest account of what it is for.
 *
 * It earns **no rich results**, and it is worth writing that down so nobody
 * measures it against the wrong expectation. Google restricted FAQ rich results
 * to authoritative health and government sites in 2023 and deprecated them
 * outright in May 2026; `MobileApplication` never produced a visual result at
 * all. Two things do make it worth the bytes:
 *
 *  1. **Entity disambiguation.** "Sonar" collides with SonarQube, Sonos, sonar
 *     the technology, marine fish finders and at least one dating app. An
 *     `Organization` plus `WebSite` node is how a search engine is told which
 *     one this is.
 *  2. **Answer engines.** A meaningful share of "how do I stop betting" now
 *     happens inside an assistant rather than a results page, and those reward a
 *     small number of clean, explicitly factual, well-structured pages — which is
 *     exactly what this site is. The `offers` array is the part that matters
 *     most, because it makes the price machine-readable and therefore consistent
 *     with what the landing page and the terms say.
 *
 * **This does not break the privacy claim, and the `<script>` tag is not the
 * exception it looks like.** Inline JSON-LD loads nothing, executes nothing and
 * contacts no one — `type="application/ld+json"` is data, not JavaScript. The
 * repo's guard is `grep -ohE 'src="https?://[^"]+"' dist/**` and it stays green,
 * because there is no `src`. Do not "improve" this by moving it to a file.
 *
 * Deliberately absent: `AggregateRating` and `Review`, because there are no
 * ratings and inventing them is a manual-action offence; and `HowTo`, because a
 * "how to stop gambling" recipe is an outcome claim in machine-readable form,
 * which is worse than making one in prose since it cannot be qualified.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#org`,
      name: LEGAL_NAME,
      url: SITE_URL,
      email: `mailto:${CONTACT_EMAIL}`,
      ...(APP_STORE_URL ? { sameAs: [APP_STORE_URL] } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#site`,
      name: APP_NAME,
      url: SITE_URL,
      inLanguage: copy.htmlLang,
      publisher: { '@id': `${SITE_URL}/#org` },
    },
    // The app itself, on the landing page only — it is a claim about the product,
    // and repeating it under the privacy policy would say the policy is the app.
    ...(route === 'home'
      ? [
          {
            '@type': 'MobileApplication',
            '@id': `${SITE_URL}/#app`,
            name: APP_NAME,
            operatingSystem: 'iOS',
            applicationCategory: 'HealthApplication',
            inLanguage: ['en', 'fr'],
            description,
            publisher: { '@id': `${SITE_URL}/#org` },
            ...(APP_STORE_URL ? { installUrl: APP_STORE_URL } : {}),
            // A single zero-price offer while the app charges nothing. This is
            // the copy of the price that a search or answer engine actually
            // reads, so leaving the three plans in here would have published a
            // price to every machine that asks while every human-readable page
            // said the app was free — the one mismatch nobody would have seen.
            offers: PAID
              ? [
                  { price: PRICING.monthlyMinor / 100, name: 'Monthly' },
                  { price: PRICING.annualMinor / 100, name: 'Annual' },
                  { price: PRICING.lifetimeMinor / 100, name: 'Lifetime' },
                ].map((o) => ({
                  '@type': 'Offer',
                  name: o.name,
                  price: o.price.toFixed(2),
                  priceCurrency: PRICING.currency,
                  category: o.name === 'Lifetime' ? 'OneTimePayment' : 'Subscription',
                }))
              : [{ '@type': 'Offer', price: '0', priceCurrency: PRICING.currency }],
          },
        ]
      : []),
  ],
};
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      alternates(route).map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={new URL(alt.href, SITE_URL).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(path('en', route), SITE_URL).href} />

    {/*
      Three sizes of one mark, all resampled from `og-icon.png`, which is the
      1024px master.

      48px alone was the whole set before, which a 2× tab bar had to upscale — and
      `apple-touch-icon` was pointed at the 1024px master itself, so adding a
      bookmark to a home screen pulled 32KB to render 180px of it.

      Not to be replaced with `../mobile/assets/favicon.png`: that file is still
      Expo's template artwork, blue with the alignment guides visible in it.
    */}
    <link rel="icon" href="/favicon.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* Approved copy, not a fresh sentence: rule 1 applies to alt attributes
         too, and this is what the card actually has printed on it. */}
    <meta property="og:image:alt" content={`${APP_NAME} — ${copy.landing.tagline}`} />
    {/* `summary_large_image` now that there is a wide image to put in it. */}
    <meta name="twitter:card" content="summary_large_image" />

    {
      /*
       * Safari's Smart App Banner. One meta tag, no JavaScript, no network
       * request, and nothing stored — iOS Safari renders it natively and every
       * other browser ignores it. `app-argument` carries the campaign token so a
       * tap through the banner is separable in App Store Connect.
       *
       * Only rendered once there is an app id to point at. Note that Apple's own
       * reporting for this surface is patchy; treat it as a convenience for the
       * reader rather than as a measurement channel.
       */
      APP_STORE_APP_ID && (
        <meta
          name="apple-itunes-app"
          content={`app-id=${APP_STORE_APP_ID}, app-argument=${new URL(path(locale, route), SITE_URL).href}?ct=${locale === 'fr' ? CAMPAIGN.webFr : CAMPAIGN.webEn}`}
        />
      )
    }

    {/*
      No analytics, no fonts, no third-party anything. The privacy policy claims
      this page sets no cookies and loads no external resources; adding a script
      tag with a `src` here would make that claim false, so don't.

      The one `<script>` below is not an exception to that: `application/ld+json`
      is inline data, never executed and never fetched, so nothing leaves the
      reader's browser. The repo's guard grep looks for `src="http..."` and stays
      green. See the note on `structuredData` above for why it exists at all.
    */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <a class="skip-link" href="#main">{copy.nav.skipToContent}</a>

    {/*
      Reading progress. Scrubbed by scroll position in CSS, so it carries no
      state and needs no script. Presentational only — it duplicates the
      scrollbar, which assistive tech already reports.
    */}
    <div class="progress" aria-hidden="true"></div>

    <header class="site-header">
      <div class="page site-header__inner">
        <a class="wordmark" href={path(locale, 'home')}>
          <Mark class="wordmark__mark" size={20} />
          <span>{APP_NAME}</span>
        </a>

        <nav class="site-nav" aria-label={copy.nav.primaryNavLabel}>
          <a href={path(locale, 'help')} class="site-nav__link site-nav__link--help">
            {copy.nav.help}
          </a>
          <a href={path(locale, 'support')} class="site-nav__link">{copy.nav.support}</a>
          <a
            href={path(other, route)}
            class="site-nav__link"
            lang={other}
            hreflang={other}
            aria-label={`${copy.nav.languageLabel}: ${t(other).localeName}`}
          >
            {t(other).localeName}
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>

<style>
  /*
   * Sticky, and that is a duty-of-care decision rather than a stylistic one.
   * "Crisis resources stay reachable from every page" is in AGENTS.md; on a long
   * page it was only reachable from the *top* of every page. Someone reading the
   * money section at 1am shouldn't have to scroll back up to find the help link.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--c-border);
    /*
     * 93%, not the 86% this started at. The display face is large enough that a
     * serif line passing underneath stayed readable through the blur, and two
     * competing texts in the same band is exactly the kind of busy this site is
     * trying not to be. Frosted, not transparent.
     */
    background: color-mix(in srgb, var(--c-bg) 93%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    /* Held still while the document underneath crossfades — see the
       view-transition block in base.css. */
    view-transition-name: site-header;
  }

  /* Translucency is only safe where it can actually be blurred; without the
     filter, hero copy would scroll through the header legibly enough to read. */
  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--c-bg);
    }
  }

  /* Named separately from the header so the two crossfade independently: the
     document changes, the furniture around it doesn't. */
  main {
    view-transition-name: page-content;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 64px;
    flex-wrap: wrap;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    /* One bar-width of clear space between mark and word, which is the
       identity bundle's rule and at 20px works out at about 4px. Using the
       gap rather than padding inside the SVG keeps the mark's own box tight,
       so it optically centres against the cap height rather than the ascender. */
    gap: 0.45em;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* Follows the palette in both themes because the SVG paints with
     currentColor. `--c-accent` and not the text colour: the mark is the one
     place on the page allowed to carry the app's green. */
  .wordmark__mark {
    color: var(--c-accent);
    flex: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--type-small);
  }

  .site-nav__link {
    position: relative;
    color: var(--c-text-muted);
    text-decoration: none;
    padding-block: var(--space-sm);
    transition: color var(--motion-fast) ease-out;
  }

  .site-nav__link:hover {
    color: var(--c-text);
  }

  /*
   * A 1px rule drawn in from the left, rather than an underline that snaps on.
   *
   * This is deliberately not the thing invariant 3 forbids. Nothing grows, the
   * link doesn't scale, and there is no payoff at the end of it — it's a pointer
   * telling you where the target is, and it retracts the moment you leave. The
   * transform is on the rule, never on the link.
   */
  .site-nav__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-base) ease-out;
  }

  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after {
    transform: scaleX(1);
  }

  /* Reachable from every page, in one tap, without being shouty about it. */
  .site-nav__link--help {
    color: var(--c-text);
    font-weight: 600;
  }
</style>
